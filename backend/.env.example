# Enable the LiteLLM answer layer after configuring the provider credential.
LLM_ENABLED=false
LLM_MODEL=openai/sarvam-105b-conversations
LLM_API_BASE=https://api.sarvam.ai/v1
LLM_API_KEY_ENV=SARVAM_API_KEY
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=20
LLM_RESPONSE_FORMAT=json_object
# Leave empty to disable Sarvam reasoning for low-latency diagnostic steps.
LLM_REASONING_EFFORT=

# Configure this outside Git:
# SARVAM_API_KEY=replace-me

# Sarvam Saaras realtime STT. Disabled until the voice transport is enabled.
SARVAM_STT_ENABLED=false
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODE=transcribe
SARVAM_STT_STREAM_TYPE=fast
SARVAM_STT_ENDPOINTING=vad
SARVAM_STT_ENCODING=linear16
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_VAD_THRESHOLD=0.3
SARVAM_STT_SILENCE_MS=500
SARVAM_STT_MIN_SPEECH_MS=250

# Sarvam Bulbul v3 realtime TTS. Disabled until the voice transport is enabled.
SARVAM_TTS_ENABLED=false
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=manan
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_CODEC=linear16
SARVAM_TTS_SEND_COMPLETION_EVENT=true
